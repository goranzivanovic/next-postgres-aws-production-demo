{
    "name":  "next-postgres-aws-production-demo",
    "version":  "1.0.0",
    "private":  false,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "typecheck":  "tsc --noEmit",
                    "test":  "node --test tests/*.test.mjs",
                    "db:up":  "docker compose up -d db",
                    "db:down":  "docker compose down",
                    "db:test":  "powershell -ExecutionPolicy Bypass -File scripts/db-test.ps1",
                    "smoke":  "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1",
                    "e2e":  "playwright test"
                },
    "dependencies":  {
                         "next":  "^16.0.0",
                         "pg":  "^8.16.3",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.63.0",
                            "@types/node":  "^24.7.2",
                            "@types/pg":  "^8.15.5",
                            "@types/react":  "^19.2.2",
                            "@types/react-dom":  "^19.2.2",
                            "typescript":  "^5.9.3"
                        }
}
